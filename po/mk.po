#: src/input/command.zig:149
msgid "Reset Terminal"
msgstr "Ресетирај терминал"

#: src/input/command.zig:150
msgid "Reset the terminal to a clean state."
msgstr "Ресетирај го терминалот во чиста состојба."

#: src/input/command.zig:155
msgid "Copy to Clipboard"
msgstr "Копирај во привремена меморија"

#: src/input/command.zig:156
msgid ""
"Copy the selected text to the clipboard in both plain and styled formats."
msgstr ""
"Копирај го избраниот текст во привремената меморија и како обичен и како "
"форматиран текст."

#: src/input/command.zig:159
msgid "Copy Selection as Plain Text to Clipboard"
msgstr "Копирај го избраното како обичен текст во привремена меморија"

#: src/input/command.zig:160
msgid "Copy the selected text as plain text to the clipboard."
msgstr "Копирај го избраниот текст како обичен текст во привремената меморија."

#: src/input/command.zig:163
msgid "Copy Selection as ANSI Sequences to Clipboard"
msgstr "Копирај го избраното како ANSI-секвенци во привремена меморија"

#: src/input/command.zig:164
msgid "Copy the selected text as ANSI escape sequences to the clipboard."
msgstr ""
"Копирај го избраниот текст како ANSI-контролни секвенци во привремената "
"меморија."

#: src/input/command.zig:167
msgid "Copy Selection as HTML to Clipboard"
msgstr "Копирај го избраното како HTML во привремена меморија"

#: src/input/command.zig:168
msgid "Copy the selected text as HTML to the clipboard."
msgstr "Копирај го избраниот текст како HTML во привремената меморија."

#: src/input/command.zig:173
msgid "Copy URL to Clipboard"
msgstr "Копирај URL во привремена меморија"

#: src/input/command.zig:174
msgid "Copy the URL under the cursor to the clipboard."
msgstr "Копирај го URL-то под покажувачот во привремената меморија."

#: src/input/command.zig:179
msgid "Copy Terminal Title to Clipboard"
msgstr "Копирај го насловот на терминалот во привремена меморија"

#: src/input/command.zig:180
msgid ""
"Copy the terminal title to the clipboard. If the terminal title is not set "
"this has no effect."
msgstr ""
"Копирај го насловот на терминалот во привремената меморија. Ако насловот не "
"е поставен, ова нема дејство."

#: src/input/command.zig:185
msgid "Paste from Clipboard"
msgstr "Вметни од привремена меморија"

#: src/input/command.zig:186
msgid "Paste the contents of the main clipboard."
msgstr "Вметни ја содржината од главната привремена меморија."

#: src/input/command.zig:191
msgid "Paste from Selection"
msgstr "Вметни од избраното"

#: src/input/command.zig:192
msgid "Paste the contents of the selection clipboard."
msgstr "Вметни ја содржината од привремената меморија за избраното."

#: src/input/command.zig:197
msgid "Start Search"
msgstr "Започни пребарување"

#: src/input/command.zig:198
msgid "Start a search if one isn't already active."
msgstr "Започни пребарување ако веќе нема активно."

#: src/input/command.zig:203
msgid "Search Selection"
msgstr "Пребарај го избраното"

#: src/input/command.zig:204
msgid "Start a search for the current text selection."
msgstr "Започни пребарување на тековно избраниот текст."

#: src/input/command.zig:209
msgid "End Search"
msgstr "Заврши пребарување"

#: src/input/command.zig:210
msgid "End the current search if any and hide any GUI elements."
msgstr ""
"Заврши го тековното пребарување, ако постои, и скриј ги сите елементи на "
"графичкиот интерфејс."

#: src/input/command.zig:215
msgid "Next Search Result"
msgstr "Следен резултат од пребарувањето"

#: src/input/command.zig:216
msgid "Navigate to the next search result, if any."
msgstr "Оди до следниот резултат од пребарувањето, ако постои."

#: src/input/command.zig:219
msgid "Previous Search Result"
msgstr "Претходен резултат од пребарувањето"

#: src/input/command.zig:220
msgid "Navigate to the previous search result, if any."
msgstr "Оди до претходниот резултат од пребарувањето, ако постои."

#: src/input/command.zig:225
msgid "Increase Font Size"
msgstr "Зголеми ја големината на фонтот"

#: src/input/command.zig:226
msgid "Increase the font size by 1 point."
msgstr "Зголеми ја големината на фонтот за 1 точка."

#: src/input/command.zig:231
msgid "Decrease Font Size"
msgstr "Намали ја големината на фонтот"

#: src/input/command.zig:232
msgid "Decrease the font size by 1 point."
msgstr "Намали ја големината на фонтот за 1 точка."

#: src/input/command.zig:237
msgid "Reset Font Size"
msgstr "Ресетирај ја големината на фонтот"

#: src/input/command.zig:238
msgid "Reset the font size to the default."
msgstr "Врати ја големината на фонтот на стандардната."

#: src/input/command.zig:243
msgid "Clear Screen"
msgstr "Исчисти екран"

#: src/input/command.zig:244
msgid "Clear the screen and scrollback."
msgstr "Исчисти ги екранот и историјата на лизгање."

#: src/input/command.zig:249
msgid "Select All"
msgstr "Избери сè"

#: src/input/command.zig:250
msgid "Select all text on the screen."
msgstr "Избери го целиот текст на екранот."

#: src/input/command.zig:255
msgid "Scroll to Top"
msgstr "Лизгај до врвот"

#: src/input/command.zig:256
msgid "Scroll to the top of the screen."
msgstr "Лизгај до врвот на екранот."

#: src/input/command.zig:261
msgid "Scroll to Bottom"
msgstr "Лизгај до дното"

#: src/input/command.zig:262
msgid "Scroll to the bottom of the screen."
msgstr "Лизгај до дното на екранот."

#: src/input/command.zig:267
msgid "Scroll to Selection"
msgstr "Лизгај до избраното"

#: src/input/command.zig:268
msgid "Scroll to the selected text."
msgstr "Лизгај до избраниот текст."

#: src/input/command.zig:273
msgid "Scroll Page Up"
msgstr "Лизгај една страница нагоре"

#: src/input/command.zig:274
msgid "Scroll the screen up by a page."
msgstr "Лизгај го екранот една страница нагоре."

#: src/input/command.zig:279
msgid "Scroll Page Down"
msgstr "Лизгај една страница надолу"

#: src/input/command.zig:280
msgid "Scroll the screen down by a page."
msgstr "Лизгај го екранот една страница надолу."

#: src/input/command.zig:286
msgid "Copy Screen to Temporary File and Copy Path"
msgstr "Копирај го екранот во привремена датотека и копирај ја патеката"

#: src/input/command.zig:287
msgid ""
"Copy the screen contents to a temporary file and copy the path to the "
"clipboard."
msgstr ""
"Копирај ја содржината на екранот во привремена датотека и копирај ја "
"патеката во привремената меморија."

#: src/input/command.zig:291
msgid "Copy Screen to Temporary File and Paste Path"
msgstr "Копирај го екранот во привремена датотека и вметни ја патеката"

#: src/input/command.zig:292
msgid ""
"Copy the screen contents to a temporary file and paste the path to the file."
msgstr ""
"Копирај ја содржината на екранот во привремена датотека и вметни ја патеката "
"до датотеката."

#: src/input/command.zig:296
msgid "Copy Screen to Temporary File and Open"
msgstr "Копирај го екранот во привремена датотека и отвори ја"

#: src/input/command.zig:297
msgid "Copy the screen contents to a temporary file and open it."
msgstr "Копирај ја содржината на екранот во привремена датотека и отвори ја."

#: src/input/command.zig:305
msgid "Copy Screen as HTML to Temporary File and Copy Path"
msgstr ""
"Копирај го екранот како HTML во привремена датотека и копирај ја патеката"

#: src/input/command.zig:306
msgid ""
"Copy the screen contents as HTML to a temporary file and copy the path to "
"the clipboard."
msgstr ""
"Копирај ја содржината на екранот како HTML во привремена датотека и копирај "
"ја патеката во привремената меморија."

#: src/input/command.zig:313
msgid "Copy Screen as HTML to Temporary File and Paste Path"
msgstr ""
"Копирај го екранот како HTML во привремена датотека и вметни ја патеката"

#: src/input/command.zig:314
msgid ""
"Copy the screen contents as HTML to a temporary file and paste the path to "
"the file."
msgstr ""
"Копирај ја содржината на екранот како HTML во привремена датотека и вметни "
"ја патеката до датотеката."

#: src/input/command.zig:321
msgid "Copy Screen as HTML to Temporary File and Open"
msgstr "Копирај го екранот како HTML во привремена датотека и отвори ја"

#: src/input/command.zig:322
msgid "Copy the screen contents as HTML to a temporary file and open it."
msgstr ""
"Копирај ја содржината на екранот како HTML во привремена датотека и отвори "
"ја."

#: src/input/command.zig:330
msgid "Copy Screen as ANSI Sequences to Temporary File and Copy Path"
msgstr ""
"Копирај го екранот како ANSI-секвенци во привремена датотека и копирај ја "
"патеката"

#: src/input/command.zig:331
msgid ""
"Copy the screen contents as ANSI escape sequences to a temporary file and "
"copy the path to the clipboard."
msgstr ""
"Копирај ја содржината на екранот како ANSI-контролни секвенци во привремена "
"датотека и копирај ја патеката во привремената меморија."

#: src/input/command.zig:338
msgid "Copy Screen as ANSI Sequences to Temporary File and Paste Path"
msgstr ""
"Копирај го екранот како ANSI-секвенци во привремена датотека и вметни ја "
"патеката"

#: src/input/command.zig:339
msgid ""
"Copy the screen contents as ANSI escape sequences to a temporary file and "
"paste the path to the file."
msgstr ""
"Копирај ја содржината на екранот како ANSI-контролни секвенци во привремена "
"датотека и вметни ја патеката до датотеката."

#: src/input/command.zig:346
msgid "Copy Screen as ANSI Sequences to Temporary File and Open"
msgstr ""
"Копирај го екранот како ANSI-секвенци во привремена датотека и отвори ја"

#: src/input/command.zig:347
msgid ""
"Copy the screen contents as ANSI escape sequences to a temporary file and "
"open it."
msgstr ""
"Копирај ја содржината на екранот како ANSI-контролни секвенци во привремена "
"датотека и отвори ја."

#: src/input/command.zig:354
msgid "Copy Selection to Temporary File and Copy Path"
msgstr "Копирај го избраното во привремена датотека и копирај ја патеката"

#: src/input/command.zig:355
msgid ""
"Copy the selection contents to a temporary file and copy the path to the "
"clipboard."
msgstr ""
"Копирај ја избраната содржина во привремена датотека и копирај ја патеката "
"во привремената меморија."

#: src/input/command.zig:359
msgid "Copy Selection to Temporary File and Paste Path"
msgstr "Копирај го избраното во привремена датотека и вметни ја патеката"

#: src/input/command.zig:360
msgid ""
"Copy the selection contents to a temporary file and paste the path to the "
"file."
msgstr ""
"Копирај ја избраната содржина во привремена датотека и вметни ја патеката до "
"датотеката."

#: src/input/command.zig:364
msgid "Copy Selection to Temporary File and Open"
msgstr "Копирај го избраното во привремена датотека и отвори ја"

#: src/input/command.zig:365
msgid "Copy the selection contents to a temporary file and open it."
msgstr "Копирај ја избраната содржина во привремена датотека и отвори ја."

#: src/input/command.zig:373
msgid "Copy Selection as HTML to Temporary File and Copy Path"
msgstr ""
"Копирај го избраното како HTML во привремена датотека и копирај ја патеката"

#: src/input/command.zig:374
msgid ""
"Copy the selection contents as HTML to a temporary file and copy the path to "
"the clipboard."
msgstr ""
"Копирај ја избраната содржина како HTML во привремена датотека и копирај ја "
"патеката во привремената меморија."

#: src/input/command.zig:381
msgid "Copy Selection as HTML to Temporary File and Paste Path"
msgstr ""
"Копирај го избраното како HTML во привремена датотека и вметни ја патеката"

#: src/input/command.zig:382
msgid ""
"Copy the selection contents as HTML to a temporary file and paste the path "
"to the file."
msgstr ""
"Копирај ја избраната содржина како HTML во привремена датотека и вметни ја "
"патеката до датотеката."

#: src/input/command.zig:389
msgid "Copy Selection as HTML to Temporary File and Open"
msgstr "Копирај го избраното како HTML во привремена датотека и отвори ја"

#: src/input/command.zig:390
msgid "Copy the selection contents as HTML to a temporary file and open it."
msgstr ""
"Копирај ја избраната содржина како HTML во привремена датотека и отвори ја."

#: src/input/command.zig:398
msgid "Copy Selection as ANSI Sequences to Temporary File and Copy Path"
msgstr ""
"Копирај го избраното како ANSI-секвенци во привремена датотека и копирај ја "
"патеката"

#: src/input/command.zig:399
msgid ""
"Copy the selection contents as ANSI escape sequences to a temporary file and "
"copy the path to the clipboard."
msgstr ""
"Копирај ја избраната содржина како ANSI-контролни секвенци во привремена "
"датотека и копирај ја патеката во привремената меморија."

#: src/input/command.zig:406
msgid "Copy Selection as ANSI Sequences to Temporary File and Paste Path"
msgstr ""
"Копирај го избраното како ANSI-секвенци во привремена датотека и вметни ја "
"патеката"

#: src/input/command.zig:407
msgid ""
"Copy the selection contents as ANSI escape sequences to a temporary file and "
"paste the path to the file."
msgstr ""
"Копирај ја избраната содржина како ANSI-контролни секвенци во привремена "
"датотека и вметни ја патеката до датотеката."

#: src/input/command.zig:414
msgid "Copy Selection as ANSI Sequences to Temporary File and Open"
msgstr ""
"Копирај го избраното како ANSI-секвенци во привремена датотека и отвори ја"

#: src/input/command.zig:415
msgid ""
"Copy the selection contents as ANSI escape sequences to a temporary file and "
"open it."
msgstr ""
"Копирај ја избраната содржина како ANSI-контролни секвенци во привремена "
"датотека и отвори ја."

#: src/input/command.zig:421
msgid "New Window"
msgstr "Нов прозор"

#: src/input/command.zig:422
msgid "Open a new window."
msgstr "Отвори нов прозор."

#: src/input/command.zig:427
msgid "New Tab"
msgstr "Ново јазиче"

#: src/input/command.zig:428
msgid "Open a new tab."
msgstr "Отвори ново јазиче."

#: src/input/command.zig:434
msgid "Move Tab Left"
msgstr "Премести го јазичето налево"

#: src/input/command.zig:435
msgid "Move the current tab to the left."
msgstr "Премести го тековното јазиче налево."

#: src/input/command.zig:439
msgid "Move Tab Right"
msgstr "Премести го јазичето надесно"

#: src/input/command.zig:440
msgid "Move the current tab to the right."
msgstr "Премести го тековното јазиче надесно."

#: src/input/command.zig:446
msgid "Move Tab to New Window"
msgstr "Премести го јазичето во нов прозор"

#: src/input/command.zig:447
msgid "Move the current tab to a new window."
msgstr "Премести го тековното јазиче во нов прозор."

#: src/input/command.zig:452
msgid "Change Terminal Title…"
msgstr "Промени наслов на терминал…"

#: src/input/command.zig:453
msgid "Prompt for a new title for the current terminal."
msgstr "Побарај нов наслов за тековниот терминал."

#: src/input/command.zig:458
msgid "Change Tab Title…"
msgstr "Промени наслов на јазиче…"

#: src/input/command.zig:459
msgid "Prompt for a new title for the current tab."
msgstr "Побарај нов наслов за тековното јазиче."

#: src/input/command.zig:465
msgid "Split Left"
msgstr "Подели налево"

#: src/input/command.zig:466
msgid "Split the terminal to the left."
msgstr "Подели го терминалот налево."

#: src/input/command.zig:470
msgid "Split Right"
msgstr "Подели надесно"

#: src/input/command.zig:471
msgid "Split the terminal to the right."
msgstr "Подели го терминалот надесно."

#: src/input/command.zig:475
msgid "Split Up"
msgstr "Подели нагоре"

#: src/input/command.zig:476
msgid "Split the terminal up."
msgstr "Подели го терминалот нагоре."

#: src/input/command.zig:480
msgid "Split Down"
msgstr "Подели надолу"

#: src/input/command.zig:481
msgid "Split the terminal down."
msgstr "Подели го терминалот надолу."

#: src/input/command.zig:488
msgid "Focus Split: Previous"
msgstr "Фокусирај поделба: претходна"

#: src/input/command.zig:489
msgid "Focus the previous split, if any."
msgstr "Фокусирај ја претходната поделба, ако постои."

#: src/input/command.zig:493
msgid "Focus Split: Next"
msgstr "Фокусирај поделба: следна"

#: src/input/command.zig:494
msgid "Focus the next split, if any."
msgstr "Фокусирај ја следната поделба, ако постои."

#: src/input/command.zig:498
msgid "Focus Split: Left"
msgstr "Фокусирај поделба: лево"

#: src/input/command.zig:499
msgid "Focus the split to the left, if it exists."
msgstr "Фокусирај ја поделбата одлево, ако постои."

#: src/input/command.zig:503
msgid "Focus Split: Right"
msgstr "Фокусирај поделба: десно"

#: src/input/command.zig:504
msgid "Focus the split to the right, if it exists."
msgstr "Фокусирај ја поделбата оддесно, ако постои."

#: src/input/command.zig:508
msgid "Focus Split: Up"
msgstr "Фокусирај поделба: горе"

#: src/input/command.zig:509
msgid "Focus the split above, if it exists."
msgstr "Фокусирај ја поделбата погоре, ако постои."

#: src/input/command.zig:513
msgid "Focus Split: Down"
msgstr "Фокусирај поделба: долу"

#: src/input/command.zig:514
msgid "Focus the split below, if it exists."
msgstr "Фокусирај ја поделбата подолу, ако постои."

#: src/input/command.zig:521
msgid "Focus Window: Previous"
msgstr "Фокусирај прозор: претходен"

#: src/input/command.zig:522
msgid "Focus the previous window, if any."
msgstr "Фокусирај го претходниот прозор, ако постои."

#: src/input/command.zig:526
msgid "Focus Window: Next"
msgstr "Фокусирај прозор: следен"

#: src/input/command.zig:527
msgid "Focus the next window, if any."
msgstr "Фокусирај го следниот прозор, ако постои."

#: src/input/command.zig:533
msgid "Toggle Split Zoom"
msgstr "Вклучи или исклучи зумирање на поделбата"

#: src/input/command.zig:534
msgid "Toggle the zoom state of the current split."
msgstr "Вклучи или исклучи ја зумираната состојба на тековната поделба."

#: src/input/command.zig:539
msgid "Toggle Read-Only Mode"
msgstr "Вклучи или исклучи режим само за читање"

#: src/input/command.zig:540
msgid "Toggle read-only mode for the current surface."
msgstr "Вклучи или исклучи го режимот само за читање за тековната површина."

#: src/input/command.zig:545
msgid "Equalize Splits"
msgstr "Изедначи ги поделбите"

#: src/input/command.zig:546
msgid "Equalize the size of all splits."
msgstr "Изедначи ја големината на сите поделби."

#: src/input/command.zig:551
msgid "Reset Window Size"
msgstr "Ресетирај ја големината на прозорецот"

#: src/input/command.zig:552
msgid "Reset the window size to the default."
msgstr "Врати ја големината на прозорецот на стандардната."

#: src/input/command.zig:557
msgid "Toggle Inspector"
msgstr "Вклучи или исклучи го инспекторот"

#: src/input/command.zig:558
msgid "Toggle the inspector."
msgstr "Вклучи или исклучи го инспекторот."

#: src/input/command.zig:563
msgid "Show On-Screen Keyboard"
msgstr "Прикажи тастатура на екранот"

#: src/input/command.zig:564
msgid "Show the on-screen keyboard if present."
msgstr "Прикажи ја тастатурата на екранот ако е достапна."

#: src/input/command.zig:570
msgid "Open Config Using OS editor"
msgstr "Отвори ја конфигурацијата со уредувачот на оперативниот систем"

#: src/input/command.zig:571
msgid "Open the config file with the OS's default editor."
msgstr ""
"Отвори ја конфигурациската датотека со стандардниот уредувач на оперативниот "
"систем."

#: src/input/command.zig:575
msgid "Open Config in New Terminal Window"
msgstr "Отвори ја конфигурацијата во нов терминал прозор"

#: src/input/command.zig:576
msgid "Open the config file in a new window using $EDITOR or $VISUAL."
msgstr ""
"Отвори ја конфигурациската датотека во нов прозор користејќи $EDITOR или "
"$VISUAL."

#: src/input/command.zig:582
msgid "Reload Config"
msgstr "Одново вчитај ја конфигурацијата"

#: src/input/command.zig:583
msgid "Reload the config file."
msgstr "Одново вчитај ја конфигурациската датотека."

#: src/input/command.zig:588
msgid "Close Terminal"
msgstr "Затвори терминал"

#: src/input/command.zig:589
msgid "Close the current terminal."
msgstr "Затвори го тековниот терминал."

#: src/input/command.zig:595
msgid "Close Tab"
msgstr "Затвори јазиче"

#: src/input/command.zig:596
msgid "Close the current tab."
msgstr "Затвори го тековното јазиче."

#: src/input/command.zig:600
msgid "Close Other Tabs"
msgstr "Затвори ги другите јазичиња"

#: src/input/command.zig:601
msgid "Close all tabs in this window except the current one."
msgstr "Затвори ги сите јазичиња во овој прозор освен тековното."

#: src/input/command.zig:605
msgid "Close Tabs to the Right"
msgstr "Затвори ги јазичињата надесно"

#: src/input/command.zig:606
msgid "Close all tabs to the right of the current one."
msgstr "Затвори ги сите јазичиња десно од тековното."

#: src/input/command.zig:612
msgid "Close Window"
msgstr "Затвори прозор"

#: src/input/command.zig:613
msgid "Close the current window."
msgstr "Затвори го тековниот прозор."

#: src/input/command.zig:618
msgid "Close All Windows"
msgstr "Затвори ги сите прозорци"

#: src/input/command.zig:619
msgid "Close all windows."
msgstr "Затвори ги сите прозорци."

#: src/input/command.zig:624
msgid "Toggle Maximize"
msgstr "Вклучи или исклучи максимизирање"

#: src/input/command.zig:625
msgid "Toggle the maximized state of the current window."
msgstr "Вклучи или исклучи ја максимизираната состојба на тековниот прозор."

#: src/input/command.zig:630
msgid "Toggle Fullscreen"
msgstr "Вклучи или исклучи цел екран"

#: src/input/command.zig:631
msgid "Toggle the fullscreen state of the current window."
msgstr "Вклучи или исклучи го приказот на цел екран за тековниот прозор."

#: src/input/command.zig:636
msgid "Toggle Float on Top"
msgstr "Вклучи или исклучи лебдење на врвот"

#: src/input/command.zig:637
msgid "Toggle the float on top state of the current window."
msgstr ""
"Вклучи или исклучи го лебдењето на тековниот прозор над другите прозорци."

#: src/input/command.zig:642
msgid "Toggle Secure Input"
msgstr "Вклучи или исклучи безбеден внес"

#: src/input/command.zig:643
msgid "Toggle secure input mode."
msgstr "Вклучи или исклучи го режимот за безбеден внес."

#: src/input/command.zig:648
msgid "Toggle Mouse Reporting"
msgstr "Вклучи или исклучи пријавување на глувчето"

#: src/input/command.zig:649
msgid "Toggle whether mouse events are reported to terminal applications."
msgstr ""
"Вклучи или исклучи дали настаните од глувчето се пријавуваат на терминал "
"апликациите."

#: src/input/command.zig:654
msgid "Toggle Background Opacity"
msgstr "Вклучи или исклучи непроѕирност на заднината"

#: src/input/command.zig:655
msgid "Toggle the background opacity of a window that started transparent."
msgstr ""
"Вклучи или исклучи ја непроѕирноста на заднината на прозорец што е отворен "
"како проѕирен."

#: src/input/command.zig:660
msgid "Check for Updates"
msgstr "Провери за ажурирања"

#: src/input/command.zig:661
msgid "Check for updates to the application."
msgstr "Провери дали има ажурирања за апликацијата."

#: src/input/command.zig:666
msgid "Undo"
msgstr "Врати"

#: src/input/command.zig:667
msgid "Undo the last action."
msgstr "Врати го последното дејство."

#: src/input/command.zig:672
msgid "Redo"
msgstr "Повтори"

#: src/input/command.zig:673
msgid "Redo the last undone action."
msgstr "Повтори го последното вратено дејство."

#: src/input/command.zig:678
msgid "Quit"
msgstr "Излез"

#: src/input/command.zig:679
msgid "Quit the application."
msgstr "Прекини ја апликацијата."

#: src/input/command.zig:684
msgid "Ghostty"
msgstr "Ghostty"

#: src/input/command.zig:685
msgid "Put a little Ghostty in your terminal."
msgstr "Внеси мал Ghostty во твојот терминал."
